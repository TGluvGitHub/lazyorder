# ---------------------------------------------------------------
#  Lazyorder settings
#  Keep this file private. Don't commit it, and don't leave it
#  in a folder your web server hands out to visitors.
#  If a value contains a # sign, wrap the value in "quotes".
# ---------------------------------------------------------------

# The Gmail address the app sends email FROM. It sends you a note for every
# new order, and sends your customers the "it's ready" email.
SENDING_EMAIL=

# A Gmail APP PASSWORD for the SENDING_EMAIL account (not its normal password).
# 16 letters, spaces are fine. Make one at https://myaccount.google.com/apppasswords
# (2-Step Verification has to be switched on for that account first.)
GMAIL_APP_PASSWORD=

# Where new-order emails get sent. This is also the email you log in with
# on the Kitchen page. Can be the same as SENDING_EMAIL.
PREPARER_EMAIL=

# The password you log in to the Kitchen page with. Make it long.
PREPARER_PASSWORD=

# Optional. Uncomment (remove the #) once the site is served over https:
# it turns on secure cookies and trusts your host's proxy headers.
# HTTPS=1
